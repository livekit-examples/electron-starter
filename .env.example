# LiveKit connection details used by the Electron main process to mint tokens.
# Copy this file to `.env` and fill in your project's values.
# Find these in the LiveKit Cloud dashboard (Settings › Keys) or your self-hosted config.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
